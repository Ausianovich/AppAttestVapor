@Tutorial(time: 45) {
    @Intro(title: "Integrate AppAttestVapor into an empty Vapor server") {
        Build a complete server integration and understand exactly what executes for both registration and every protected request.
    }

    @Section(title: "What App Attest integration checks in practice") {
        @ContentAndMedia {
            Every protected request passes two separate security stages.  
            Stage one creates a durable credential after one successful attestation.  
            Stage two verifies fresh challenge, valid signature, correct `keyID`, and monotonic counter for each request.
        }

        @Steps {
            @Step {
                Understand the runtime roles and the concrete trust boundary:

                - Client: `AppAttestTransport` owns key generation, Keychain `keyID`, and proof generation.
                - Server: `AppAttestRoutes` owns challenge storage and attestation proof verification entrypoints.
                - Middleware: `AppAttestMiddleware` guards only protected routes.

                @Code(name: "AppAttestFlow.swift", file: "AppAttestFlow.swift", reset: true)
            }
            @Step {
                Verify one request lifecycle:

                1. Client gets `POST /app-attest/challenge`.
                2. Client signs and calls `POST /app-attest/attestation` once per key.
                3. Server saves `(keyID, publicKey, counter)` and deletes challenge.
                4. Every protected request gets a new challenge and an assertion header set.
                5. Middleware verifies challenge freshness, signature, and counter monotonicity.

                @Code(name: "FlowVerification.swift", file: "FlowVerification.swift", reset: true)
            }
        }
    }

    @Section(title: "Add the server dependencies") {
        @ContentAndMedia {
            Start with an empty executable target named `App`. The finished target contains `entrypoint.swift`, `configure.swift`, `routes.swift`, and durable credential artifacts.
        }

        @Steps {
            @Step {
                Add Vapor, this package, Fluent/PostgreSQL, SQLKit, Dependencies, and VaporValkey to the package manifest.
                The example uses local checkout path for this repository.

                @Code(name: "Package.swift", file: "ServerPackage.swift", reset: true)
            }
            @Step {
                Add the standard asynchronous Vapor entry point.

                @Code(name: "entrypoint.swift", file: "Entrypoint.swift", reset: true)
            }
            @Step {
                Start PostgreSQL and Valkey.
                For local development use:

                - PostgreSQL database `app_attest`, URL `postgres://postgres:postgres@127.0.0.1:5432/app_attest`
                - Valkey exposed on `127.0.0.1:6379`.

                @Code(name: "LocalServices.sh", file: "LocalServices.sh", reset: true)
            }
        }
    }

    @Section(title: "Create durable credential storage") {
        @ContentAndMedia {
            Server-side credential storage must be durable and keyed by Base64 `keyID`.
            `public_key` and `counter` survive process restarts, unlike Valkey challenges.
        }

        @Steps {
            @Step {
                Add a Fluent model. `counter` is stored as PostgreSQL `BIGINT`, which safely contains `UInt32`.

                @Code(name: "AppAttestCredential.swift", file: "AppAttestCredential.swift", reset: true)
            }
            @Step {
                Add a migration. `key_id` as user id makes attestation idempotent and protects against accidental overwrite.

                @Code(name: "CreateAppAttestCredential.swift", file: "CreateAppAttestCredential.swift", reset: true)
            }
        }
    }

    @Section(title: "Implement the credential client") {
        @ContentAndMedia {
            `AppAttestCredentialClient` is the single persistence contract used by the library.
            The static factory below captures `app.db` once and implements all four required closure behaviors.
        }

        @Steps {
            @Step {
                Add a static `.database(_:)` that saves and reads by `keyID` only.

                @Code(name: "AppAttestCredentialClient+Database.swift", file: "AppAttestCredentialClient+Database.swift", reset: true)
            }
            @Step {
                Implement `advanceCounter` as one conditional `UPDATE ... RETURNING`.
                It must return `true` only when `newValue > storedValue`.
                This is the replay and reordering protection for all subsequent requests.

                @Code(name: "AdvanceCounter.sql", file: "AdvanceCounter.sql", reset: true)
            }
        }
    }

    @Section(title: "Configure startup order and App Attest services") {
        @ContentAndMedia {
            Order matters because `app.db` is available only after database setup, and App Attest routes need both Valkey and credential dependencies.
        }

        @Steps {
            @Step {
                Replace the server `configure` function.
                `prepareDependencies` installs the credential closures for the process lifetime, and `app.appAttest.configure` registers both service routes.

                @Code(name: "configure.swift", file: "ConfigureServer.swift", reset: true)
            }
            @Step {
                Check three required values before running:

                - Team ID from Apple Developer account
                - Protected app Bundle ID
                - Environment (`.development` with development entitlement, `.production` otherwise)

                @Code(name: "ServerPrereq.swift", file: "ServerPrereq.swift", reset: true)
            }
            @Step {
                Run migration before accepting traffic so credential table exists for attestation writes.

                @Code(name: "MigrateServer.sh", file: "MigrateServer.sh", reset: true)
            }
        }
    }

    @Section(title: "Protect only business routes") {
        @ContentAndMedia {
            Register service endpoints on `app`, not on middleware-wrapped groups.
            Protect only routes that must require App Attest proofs.
        }

        @Steps {
            @Step {
                Keep service routes (`/app-attest/*`) outside protected group.
                This prevents infinite recursion and allows clients to fetch challenges.

                @Code(name: "routes.swift", file: "ServerRoutes.swift", reset: true)
            }
            @Step {
                Verify behavior after launch:

                - `/health` remains public
                - `/app-attest/challenge` works without App Attest headers
                - Protected handlers require `AppAttestMiddleware`.

                @Code(name: "VerifyLocalServer.sh", file: "VerifyLocalServer.sh", reset: true)
            }
            @Step {
                Start server using the same PostgreSQL URL as migration.

                @Code(name: "RunServer.sh", file: "RunServer.sh", reset: true)
            }
        }
    }

    @Section(title: "Validate the full flow") {
        @ContentAndMedia {
            Run both service-route and protected-route checks manually and then verify from a real client transport.
        }

        @Steps {
            @Step {
                Call the service challenge endpoint with a dummy Base64 `keyID`.
                Expect `200` and a Base64 challenge value.

                @Code(name: "VerifyChallenge.sh", file: "VerifyChallenge.sh", reset: true)
            }
            @Step {
                Call a protected route without App Attest headers.
                Expect `403` and `{"code":"app_attest_invalid"}`.

                @Code(name: "VerifyProtectedRoute.sh", file: "VerifyProtectedRoute.sh", reset: true)
            }
            @Step {
                Integrate with `AppAttestTransport` in client app:

                1. First protected request performs key generation and attestation.
                2. Subsequent protected requests include assertion headers.
                3. Replay/expired challenge responses trigger bounded transport recovery.

                @Code(name: "ClientTransport.swift", file: "ClientTransport.swift", reset: true)
            }
        }
    }
}
